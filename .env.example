# ─────────────────────────────────────────────────────────────────────────────
# Ambika Electricals / Rewardly — environment template (PLACEHOLDERS ONLY).
# Copy to .env.local for local development. Never commit real values:
# every .env* file except this template is git-ignored.
# Full setup guide: SETUP_SUPABASE_AND_RESEND.md
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase project (Settings → API in the dashboard) ───────────────────────
# Leave the two NEXT_PUBLIC_SUPABASE_* values unset to keep running the
# Phase 1 mock app in Demo mode. Real auth activates once both are present.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SERVER-ONLY secret key (service role). Bypasses Row Level Security — used
# exclusively by trusted server code (auth confirmation route, invitation
# emailer, admin scripts). Must NEVER be prefixed with NEXT_PUBLIC_ and must
# never appear in browser bundles, logs or Git.
SUPABASE_SERVICE_ROLE_KEY=

# Local Supabase CLI stack only (populated by `supabase start`). Not used in
# staging/production deployments.
# SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ── Application URLs (safe auth redirect targets) ────────────────────────────
# Local:     http://localhost:3000
# Staging:   https://staging.yourdomain.com
# Prod:      https://yourdomain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Resend (mail delivery provider — decision 2.4) ───────────────────────────
# Production auth emails are sent BY SUPABASE through custom SMTP; the app
# itself only needs these for (a) local parity of the SMTP config and (b) the
# server-side staff-invitation mailer.
# RESEND_SMTP_PASSWORD: your Resend API key (re_...) used as the SMTP password.
# AUTH_EMAIL_FROM:      verified sender, e.g. no-reply@auth.yourdomain.com
RESEND_SMTP_PASSWORD=
AUTH_EMAIL_FROM=

# ── Demo mode gate ───────────────────────────────────────────────────────────
# Demo (mock) auth is always available while Supabase is NOT configured, and in
# development builds. In production builds with Supabase configured, demo mode
# is hard-disabled and cannot be enabled by end users. Set to "true" ONLY on
# dev/staging machines where you want the labelled demo quick-fill next to real
# auth. Never enable on production.
NEXT_PUBLIC_DEMO_AUTH=
